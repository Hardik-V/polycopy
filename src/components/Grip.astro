---
// Grip.astro
---

<div id="grip" class="section">
  <div class="section__inner o-container">

    <div id="grip-header">
      <div id="grip-tagline" class="sub2">Full-Stack · AI/ML · Cloud</div>
      <h2 id="grip-title">The Stack</h2>
      <div id="grip-desc" class="body2">
        Tools I ship with the best.<br />
        Find more in my CV
      </div>
    </div>

    <!-- JS hooks: zeroed out, engine still binds fine -->
    <div id="grip-zoom-box" class="sub2 prevent-select" style="position:absolute;width:0;height:0;overflow:hidden;pointer-events:none;opacity:0;">
      <div id="grip-zoom-box__inner">
        <div id="grip-zoom-box__image"></div>
        <div id="grip-zoom-box__content">
          <div id="grip-zoom-box__content-bg"></div>
          <div id="grip-zoom-box__content-label">Coverage</div>
          <div id="grip-zoom-box__content-coeff">0.93</div>
        </div>
      </div>
    </div>

    <!-- 2×2 editorial card grid -->
    <div id="grip-skills">

      <div class="grip-card" data-index="01">
        <div class="grip-skills__category">SYSTEM DESIGN</div>
        <div class="grip-bar-row">
          <span class="grip-bar-label">Distributed Systems</span>
        </div>
        <div class="grip-bar-row">
          <span class="grip-bar-label">System Architecture</span>
        </div>
        <div class="grip-bar-row">
          <span class="grip-bar-label">REST APIs</span>
        </div>
        <div class="grip-bar-row">
          <span class="grip-bar-label">Design Patterns</span>
        </div>
      </div>

      <div class="grip-card" data-index="02">
        <div class="grip-skills__category">CLOUD &amp; INFRASTRUCTURE</div>
        <div class="grip-bar-row">
          <span class="grip-bar-label">AWS</span>
        </div>
        <div class="grip-bar-row">
          <span class="grip-bar-label">Docker</span>
        </div>
        <div class="grip-bar-row">
          <span class="grip-bar-label">CI/CD</span>
        </div>
        <div class="grip-bar-row">
          <span class="grip-bar-label">Linux</span>
        </div>
      </div>

      <div class="grip-card" data-index="03">
        <div class="grip-skills__category">AI &amp; AUTOMATION</div>
        <div class="grip-bar-row">
          <span class="grip-bar-label">MCP</span>
        </div>
        <div class="grip-bar-row">
          <span class="grip-bar-label">Reverse Engineering with AI</span>
        </div>
        <div class="grip-bar-row">
          <span class="grip-bar-label">LLM APIs</span>
        </div>
        <div class="grip-bar-row">
          <span class="grip-bar-label">Agentic Workflows</span>
        </div>
      </div>

      <div class="grip-card" data-index="04">
        <div class="grip-skills__category">SOFTWARE ENGINEERING</div>
        <div class="grip-bar-row">
          <span class="grip-bar-label">Python</span>
        </div>
        <div class="grip-bar-row">
          <span class="grip-bar-label">TypeScript / JavaScript</span>
        </div>
        <div class="grip-bar-row">
          <span class="grip-bar-label">PostgreSQL</span>
        </div>
        <div class="grip-bar-row">
          <span class="grip-bar-label">Java</span>
        </div>
      </div>

    </div><!-- /#grip-skills -->

    <!-- JS animates this — hidden via overrides.css -->
    <div id="grip-instruction">
      <svg id="grip-instruction-wheel" viewBox="0 0 100 15">
        <path fill="none" stroke="currentColor" stroke-width="0.25"
          d="M50,12.125c32,0,50,-8.5,50,-10" stroke-dasharray="1 1"></path>
        <path fill="none" stroke="currentColor" stroke-width="0.25"
          d="M50,12.125c-32,0,-50,-8.5,-50,-10" stroke-dasharray="1 1"></path>
        <circle cx="50" cy="12.125" r="0.8" fill="currentColor"></circle>
        <circle id="grip-instruction-wheel-circle" cx="50" cy="12.125" r="1.8" fill="currentColor"></circle>
      </svg>
      <svg id="grip-instruction-icon">
        <use href="#hand-tmpl"></use>
      </svg>
    </div>

  </div>
</div>

<style>
  /* ── Header — visual styling only, position left to the 3D engine ──
     Matches the editorial pre-heading style seen across other sections
     (e.g. the small-caps orange label above "HARDIK VERMA").
  ────────────────────────────────────────────────────────────────── */
  #grip-tagline {
    font-family: var(--font-mono, 'DM Mono', monospace);
    font-size: calc(var(--screen-unit) * 12);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-orange, #dc5000);
    margin-bottom: calc(var(--screen-unit) * 4);
  }

  #grip-title {
    /* h2 global already sets uppercase + halyard-display-variable */
    letter-spacing: -0.02em;
  }

  #grip-desc {
    color: rgba(255, 237, 215, 0.5);
    font-weight: 400;
  }

  /* ── Grid container ─────────────────────────────────────────────────
     Same position logic as original so the 3D engine layout is intact.
  ────────────────────────────────────────────────────────────────── */
  #grip-skills {
    position: absolute;
    top: calc(var(--vh) * 40);
    left: 0;
    right: 0;
    padding: 0 var(--site-padding-x);
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: calc(var(--screen-unit) * 12);
    box-sizing: border-box;
  }

  /* ── Editorial card ─────────────────────────────────────────────────
     Replaces glass-morphism with a dashed-border editorial frame that
     matches the site's o-dashline aesthetic (lessons section, footer,
     project caption borders). Square corners, no blur, transparent bg.
  ────────────────────────────────────────────────────────────────── */
  .grip-card {
    position: relative;
    background: transparent;
    /* Dashed border matching the site's 2px-on/2px-off dash pattern */
    border: 1px dashed rgba(255, 237, 215, 0.16);
    border-radius: 0;
    padding: calc(var(--screen-unit) * 26) calc(var(--screen-unit) * 28);
    display: flex;
    flex-direction: column;
    gap: 0;
    overflow: hidden;
    transition: border-color 0.4s ease;
  }

  .grip-card:hover {
    border-color: rgba(255, 237, 215, 0.3);
  }

  /* Ghost index number — sits behind card content as a watermark.
     Uses data-index ("01"–"04") set on the HTML element above.
     Mirrors the big ghosted "HARDIK" text technique (image 8).      */
  .grip-card::before {
    content: attr(data-index);
    position: absolute;
    top: -0.18em;
    right: -0.06em;
    font-family: var(--display-font, 'halyard-display-variable');
    font-size: calc(var(--screen-unit) * 148);
    font-weight: 700;
    color: rgba(255, 237, 215, 0.035);
    line-height: 1;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  /* All card children sit above the ghost number */
  .grip-skills__category,
  .grip-bar-row {
    position: relative;
    z-index: 1;
  }

  /* ── Category label ─────────────────────────────────────────────────
     Orange · monospace · letter-spaced — same as every other section
     label on the site (e.g. "AWS λ · S3 · API GW · PYTHON · DOCKER").
     The dashed bottom rule is the o-dashline style baked in as a
     background-image so it looks identical to the site's separators.
  ────────────────────────────────────────────────────────────────── */
  .grip-skills__category {
    font-family: var(--font-mono, 'DM Mono', monospace);
    font-size: calc(var(--screen-unit) * 12);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-orange, #dc5000);
    padding-bottom: calc(var(--screen-unit) * 17);
    margin-bottom: calc(var(--screen-unit) * 6);
    /* Dashed rule: repeating 2px dash / 2px gap — matches o-dashline */
    background-image: repeating-linear-gradient(
      90deg,
      rgba(255, 237, 215, 0.22) 0 2px,
      transparent 0 4px
    );
    background-repeat: no-repeat;
    background-size: 100% 1px;
    background-position: bottom;
  }

  /* ── Skill rows ─────────────────────────────────────────────────────
     Each row is separated by a very faint dashed rule. The last row
     has no rule so the card bottom edge acts as the terminator.
     Animations remain identical to original (bars-ready toggle).
  ────────────────────────────────────────────────────────────────── */
  .grip-bar-row {
    display: flex;
    align-items: center;
    padding: calc(var(--screen-unit) * 12) 0;
    /* Subtle dashed row separator */
    background-image: repeating-linear-gradient(
      90deg,
      rgba(255, 237, 215, 0.07) 0 2px,
      transparent 0 4px
    );
    background-repeat: no-repeat;
    background-size: 100% 1px;
    background-position: bottom;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.45s ease, transform 0.45s ease;
  }

  .grip-bar-row:last-child {
    background-image: none;
  }

  #grip.bars-ready .grip-bar-row {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Skill label ────────────────────────────────────────────────────
     Switched from DM Mono to halyard-display-variable so skill names
     carry the same humanist display weight as the rest of the site's
     body and heading text (see "I don't just write code." section).
  ────────────────────────────────────────────────────────────────── */
  .grip-bar-label {
    font-family: var(--display-font, 'halyard-display-variable');
    font-size: calc(var(--screen-unit) * 18);
    font-weight: 500;
    color: rgba(255, 237, 215, 0.82);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  /* ── Legacy bar elements — hidden, preserved for JS compatibility ── */
  .grip-bar-track,
  .grip-bar-pct,
  .grip-bar-fill,
  .grip-bar-fill--accent {
    display: none;
  }

  /* ── Mobile ─────────────────────────────────────────────────────────
     Single scrollable column. Ghost numbers scale down to avoid
     overflowing. Skill labels wrap instead of nowrap.
  ────────────────────────────────────────────────────────────────── */
  @media (max-width: 767.98px) {
    #grip .section__inner {
      position: relative;
      height: auto;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    #grip-skills {
      position: relative;
      top: auto;
      margin-top: calc(var(--screen-unit) * 254);
      grid-template-columns: 1fr;
      gap: calc(var(--screen-unit) * 10);
      padding: 0 var(--site-padding-x);
    }

    .grip-card {
      padding: calc(var(--screen-unit) * 20) calc(var(--screen-unit) * 20);
    }

    .grip-card::before {
      font-size: calc(var(--screen-unit) * 110);
    }

    .grip-bar-row {
      opacity: 0;
      transform: none;
    }

    #grip.bars-ready .grip-bar-row {
      opacity: 1;
      transform: none;
    }

    .grip-bar-label {
      font-size: calc(var(--screen-unit) * 16);
      white-space: normal;
    }
  }
</style>

<script>
  /**
   * Unchanged from original.
   * MutationObserver watches #grip's inline style for visibility:visible.
   * When the 3D engine shows the section, .bars-ready is added to trigger
   * the CSS stagger transitions on rows.
   * Stagger delay is set inline per-row before the observer fires.
   */
  (function () {
    function applyStagger() {
      const cards = document.querySelectorAll('#grip-skills .grip-card');
      cards.forEach((card, ci) => {
        card.querySelectorAll('.grip-bar-row').forEach((row, ri) => {
          const delay = ci * 80 + ri * 60;
          row.style.transitionDelay = `${delay}ms`;
          const fill = row.querySelector('.grip-bar-fill');
          if (fill) fill.style.transitionDelay = `${delay + 90}ms`;
        });
      });
    }

    function init() {
      const grip = document.getElementById('grip');
      if (!grip) return;
      applyStagger();

      let fired = false;

      const trigger = () => {
        if (fired) return;
        fired = true;
        grip.classList.add('bars-ready');
        observer.disconnect();
      };

      const observer = new MutationObserver(() => {
        if (grip.style.visibility === 'visible') trigger();
      });

      observer.observe(grip, { attributes: true, attributeFilter: ['style'] });

      // Fallback if engine hasn't set visibility by 1.5s
      setTimeout(trigger, 1500);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>