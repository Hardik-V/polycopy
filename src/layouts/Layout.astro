---
// Layout.astro
// Provides the <html> + <head> shell only.
// The body structure is owned entirely by index.astro so the JS engine gets
// the exact DOM it expects without any extra wrapper divs.
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Hardik Verma · Software Engineer",
  description = "Hardik Verma, third-year software engineering student at UNSW. Software engineer at SportLogic, TSS Lead and Infotainment Lead at Sunswift Racing, SENG3011 Optiver Industry Prize. The CV, interactive.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="no-js">
  <head>
    <title>{title}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="description" content={description} />
    <meta name="author" content="Hardik Verma" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#000000" />

    <link rel="canonical" href="https://hardikv.is-a.dev/" />
    <base href="/" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/meta/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/meta/favicon.svg" />
    <link rel="shortcut icon" href="/meta/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/meta/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Hardik Verma" />
    <link rel="manifest" href="/meta/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://hardikv.is-a.dev/meta/og_image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hardik Verma, software engineer. SportLogic Play on both app stores." />
    <meta property="og:url" content="https://hardikv.is-a.dev/" />
    <meta property="og:site_name" content="Hardik Verma" />
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="en_AU" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://hardikv.is-a.dev/meta/og_image.png" />

    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Who this page is about, for a search on the name. -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Hardik Verma',
      url: 'https://hardikv.is-a.dev/',
      image: 'https://hardikv.is-a.dev/meta/og_image.png',
      jobTitle: 'Software Engineer',
      description,
      affiliation: { '@type': 'CollegeOrUniversity', name: 'UNSW Sydney' },
      worksFor: { '@type': 'Organization', name: 'SportLogic' },
      memberOf: { '@type': 'Organization', name: 'Sunswift Racing' },
      address: { '@type': 'PostalAddress', addressLocality: 'Sydney', addressRegion: 'NSW', addressCountry: 'AU' },
      email: 'mailto:hardikverma2005@gmail.com',
      sameAs: ['https://github.com/Hardik-V', 'https://www.linkedin.com/in/v-hardik', 'https://play.sportlogic.com.au/'],
      knowsAbout: ['TypeScript', 'React', 'Next.js', 'AWS', 'Flutter', 'coding agents', 'Model Context Protocol', 'web application security'],
      award: 'Optiver Industry Prize, UNSW SENG3011, 2026',
    })} />

    <!-- The original bundled engine CSS & JS. Do not edit. -->
    <link rel="stylesheet" href="/scripts/index.css" />
    <!-- Portfolio-specific visual overrides. Loaded AFTER index.css so its
         rules win the cascade. Engine bindings are untouched. -->
    <link rel="stylesheet" href="/styles/overrides.css" />
    <script type="module" src="/scripts/main.js"></script>
  </head>
  <body>
    <slot />
    <script is:inline>
      document.addEventListener(
        "DOMContentLoaded",
        () => {
          const form = document.getElementById("footer-newsletter-form");
          const input = document.getElementById("footer-email-input");
          const message = document.getElementById("footer-newsletter-message");
          if (!form || !input) return;

          form.addEventListener(
            "submit",
            (event) => {
              event.preventDefault();
              event.stopImmediatePropagation();
              const email = input.value.trim();
              if (!email) return;
              if (message) {
                message.textContent = "Opening your mail app…";
              }
              window.location.href =
                "mailto:hardikverma2005@gmail.com?subject=Portfolio%20contact&body=" +
                encodeURIComponent("Hi Hardik,\n\nMy email: " + email + "\n\n");
            },
            true
          );
        },
        { once: true }
      );
    </script>
  </body>
</html>
